[resource]
script = ExtResource("1_cg6rj")
id = 290
name = "Raiden Shogun – Burst"
element = "Electric"
description = "Raiden enters the Musou Isshin state for 4 turns. While in this state any burst charges anyone generates is also generated for everyone else. Each time an ally uses their burst Raiden gains 1 resolve stack until this state ends. Whenever an ally uses their burst damage is multiplied by the number of Resolve Stacks Raiden has (Max 4). Raiden cannot get/generate burst charge while in this state."
