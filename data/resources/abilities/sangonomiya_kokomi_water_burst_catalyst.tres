[resource]
script = ExtResource("1_37u3g")
id = 327
name = "Sangonomiya Kokomi – Burst"
element = "Water"
description = "Kokomi transforms into her Ceremonial state for 4 turns. While active, she may move up to 7 tiles before doing any other action, she may walk across all water fields without any speed penalties and her Charged attacks deal double damage. All allies are healed equal to ¼ damage dealt by her charged attack while in this state. Kokomi cannot get charges while in this state."
