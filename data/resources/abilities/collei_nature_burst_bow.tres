[resource]
script = ExtResource("1_h4are")
id = 374
name = "Collei – Burst"
element = "Nature"
description = "Collei throws the doll Cuilein-Anbar to a chosen tile, creating a small AoE field (2-tile radius) and dealing Nature Damage to all enemies inside. At the end of each turn, enemies inside take Nature damage. Said enemies are also taunted to the center if they are small.
The first time any reaction is triggered inside this field or an enemy attacks Cuilein-Anbar, it deals 1D6 bonus damage to all enemies inside and then ends the field immediately. "
