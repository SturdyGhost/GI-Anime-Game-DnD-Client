[resource]
script = ExtResource("1_jfh2g")
id = 282
name = "Nahida – Skill"
element = "Nature"
description = "Marks all enemies within 4 tiles dealing Nature damage to them and linking them for 5 turns. If any of the linked enemies have a nature reaction triggered on them, it spreads to all other linked enemies repeating the reaction to them as well. After a Nature reaction is triggered on a any linked enemy, Nature is immediately reapplied to them afterwards.
