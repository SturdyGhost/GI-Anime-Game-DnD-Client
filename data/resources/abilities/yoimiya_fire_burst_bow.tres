[resource]
script = ExtResource("1_b323y")
id = 365
name = "Yoimiya – Burst"
element = "Fire"
description = "Yoimiya leaps back 2 tiles and fires a massive firework anywhere on the map hitting all enemies in a 7x7 range. She may choose one of those enemies to be marked for 3 turns. Any allies attacking the marked enemy deals extra multiplicative damage equal to Avg. Attack roll. (i.e. Avg attack roll of 15 makes all allies attacks deal 1.5x extra damage on top of normal damage)"
