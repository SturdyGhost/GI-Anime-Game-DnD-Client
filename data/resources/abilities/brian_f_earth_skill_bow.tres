[resource]
script = ExtResource("1_ibnn7")
id = 425
name = "Brian F. – Skill"
element = "Earth"
description = "Generates a small shield around you that absorbs 1/4 of your defense roll, applying earth to you. While shielded, earth is continuously reapplied. While shielded by this when you charge attack it shoots an earthen arrow and the attack fires in a straight line to the edge of the arena hitting all in its path. (May charge attack once during the turn you activate this)."
