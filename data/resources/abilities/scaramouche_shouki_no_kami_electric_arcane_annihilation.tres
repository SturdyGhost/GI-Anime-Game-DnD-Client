script = ExtResource("1_sc003")
id = 3
name = "Arcane Annihilation"
element = "Electric"
description = "INSTA-KILL DPS CHECK - the Phase 1 precursor to Setsuna Shoumetsu. Begins charging the first time the boss drops below 60% of Phase 1 HP (210). Charges for 2 FULL ROUNDS, telegraphed the whole time - the core glows brighter each round. The party must deal 140 damage to the boss across those 2 rounds. FAIL: it resolves and EVERY PLAYER DIES, no save, defence ignored. SUCCEED: the charge shatters, no damage is dealt, and the boss is STUNNED for 1 round (loses its next action). Countdown-driven: order 99 and weight 0, never weight-rolled. trigger_window_rounds = 2 is the charge length; trigger_threshold_int = 140 is the damage required."
