[resource]
script = ExtResource("1_x3uuf")
id = 373
name = "Bennett – Burst"
element = "Fire"
description = "Summons a flaming field 3 tiles out around Bennett in every direction for 3 turns. At the start of Bennett''s turn heal all party members inside for 1 health. Anyone (including enemies) attacking from within the field, or are attacked while standing in the field shall have the damage converted to fire damage (Uses Attack for Rolls), additionally any base_damage dealt shall be increased by 1* Avg Attack roll (limit once per target)."
