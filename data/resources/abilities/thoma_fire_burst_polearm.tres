[resource]
script = ExtResource("1_ja5db")
id = 371
name = "Thoma – Burst"
element = "Fire"
description = "Generates a shield on all party members applying fire to them, this shield will absorb damage and has shield health equal to 1/4 average Max HP roll. While shielded, fire is continuously reapplied. Shield expires when health is gone or after 2 turns. Every time a party member shielded by this ability uses an attack their personal shield is extended 1 turn and 2 health is restored to the shield (cannot exceed max initial health, max 3 turn extension)"
