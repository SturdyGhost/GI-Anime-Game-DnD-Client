[resource]
script = ExtResource("1_qbb5h")
id = 434
name = "Brian F. – Burst"
element = "Water"
description = "Enter the Twilight Justice state for 3 turns, while active you may move up to your normal distance while still charge attacking. Charged attacks deal water damage that scale off your EM. You may perform 2 charged attacks per turn while this is active. +2 water damage to all hits you do while active. Charged attacks will hit a tile instead of a unit and do not knock enemies back. Charged Attack damage after all other boosts/multipliers shall be doubled. You do not generate burst charges in this state."
