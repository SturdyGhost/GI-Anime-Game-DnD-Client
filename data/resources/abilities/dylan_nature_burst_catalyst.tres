[resource]
script = ExtResource("1_2ftgs")
id = 437
name = "Dylan – Burst"
element = "Nature"
description = "Roll EM die for transformation (2 turns). Cannot move on activation turn.

1–4: Turn into a heal. A party member may interact with it to heal 1d6+EM. If no one interacts<br>by end of turn, it automatically heals the closest ally for 1d4+EM instead.

5–14: +2 movement, pull on attacks, Charged attacks root, temp HP = 1/4 EM.

15–19: All attacks and abilities gain +1 tile to their area of effect. At the end of your turn, all<br>enemies adjacent to you become Rooted. Temp HP = 1/2 EM.

20+: Choose form."
