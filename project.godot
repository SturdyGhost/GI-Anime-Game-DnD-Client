; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Genshin DnD Client"
config/version="0.0.8"
run/main_scene="res://Scenes/Lobby.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/auto_accept_quit=false

[autoload]

GameDB="*res://Singletons/GameDB.gd"
SaveManager="*res://Scripts/managers/save_manager.gd"
CharacterManager="*res://Scripts/managers/character_manager.gd"
PartyManager="*res://Scripts/managers/party_manager.gd"
InventoryManager="*res://Scripts/managers/inventory_manager.gd"
BattleManager="*res://Scripts/managers/battle_manager.gd"
Global="*res://Singletons/Global.gd"
DataStore="*res://Singletons/DataStore.gd"
NetworkManager="*res://Singletons/NetworkManager.gd"
Market="*res://Singletons/Market.gd"
ResearchAPI="*res://Singletons/ResearchAPI.gd"
System="*res://Singletons/System.gd"
Toast="*res://Singletons/Toast.gd"

[debug]

gdscript/warnings/enable=false

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/mode=2
window/stretch/mode="viewport"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/theme_gen_save_sync/plugin.cfg")

[gui]

theme/default_theme_scale=2.0
theme/custom="uid://dgfy4yirbqrg7"
theme/default_font_generate_mipmaps=true

[plugins]

ai_assistant_hub/preferences/thinking_target=0
ai_assistant_hub/preferences/skip_greeting=false
ai_assistant_hub/preferences/always_scroll_to_bottom=false
ai_assistant_hub/llm_api="ollama_api"

[rendering]

textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_2d=3
textures/decals/filter=5
textures/light_projectors/filter=5
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_debanding=true
